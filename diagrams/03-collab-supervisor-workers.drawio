<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Claude Code" version="26.0.0" type="device">
  <diagram id="w2-collab-supervisor-workers" name="W2 Supervisor + Workers Collaboration">
    <mxGraphModel dx="1480" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Supervisor + 2-Worker Collaboration — deterministic routing, inspectable hand-offs" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Each transition is a logged OTel span. The supervisor is T=0; its prompt is checked into source; its decisions are reproducible from state." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="state" value="State (LangGraph TypedDict)&#xa;• file_path · doc_type · trace_id · patient_id · encounter_id&#xa;• extracted: LabPdf | IntakeForm | None&#xa;• evidence: list[GuidelineSnippet]&#xa;• tool_sequence: list[str]&#xa;• errors: list[ErrorEvent]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="Entry — POST /api/agent/run&#xa;parses request → seeds state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sup" value="Supervisor (T=0)&#xa;Reads state. Decides ONE of:&#xa;• extract — if extracted is None&#xa;• retrieve — if guideline question and evidence is empty&#xa;• finalize — if state is sufficient&#xa;• refuse — if errors or low confidence&#xa;Prompt + decision logged as 'supervisor.route' span" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="Extractor worker&#xa;OpenAI Files API + Structured Outputs&#xa;• gpt-4o-mini · response_format=json_schema&#xa;• Pydantic v2 strict validation&#xa;• Returns extracted + per-field Citation (with bbox)&#xa;• Re-tries once with stricter prompt on schema mismatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="Retriever worker&#xa;Hybrid RAG — see diagram 04&#xa;• Builds query from state (extracted abnormal labs / chief concern)&#xa;• BM25 + dense, RRF fuse, Cohere rerank&#xa;• Returns top-5 GuidelineSnippet with Citation&#xa;• Falls back to cross-encoder if Cohere unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="finalize" value="Finalize&#xa;• Compose ExtractionResult&#xa;• Compute cost_usd, latency_ms_per_step&#xa;• Emit encounter event (no PHI)&#xa;• END node returns to FastAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="720" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="refuse" value="Safe refusal&#xa;• Returns {status: refused, reason}&#xa;• No DB writes downstream&#xa;• rubric: safe_refusal pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="730" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="state2" value="Persists handoff log&#xa;tool_sequence accumulates after every node:&#xa;['supervisor.route', 'extractor.run', 'supervisor.route', 'retriever.run', 'supervisor.finalize']" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0f172a;fontSize=12;" edge="1" parent="1" source="ingress" target="sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="route: extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="sup" target="ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="route: retrieve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="sup" target="ret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="state += {extracted}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;dashed=1;fontSize=12;" edge="1" parent="1" source="ext" target="sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="state += {evidence}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;dashed=1;fontSize=12;" edge="1" parent="1" source="ret" target="sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="route: finalize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0284c7;fontSize=12;" edge="1" parent="1" source="sup" target="finalize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="route: refuse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#e11d48;dashed=1;fontSize=12;" edge="1" parent="1" source="sup" target="refuse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="state" target="sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="appends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="sup" target="state2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="invariants" value="Invariants&#10;• Only the supervisor changes the next-node decision; workers append to state but never branch.&#10;• Workers must return either a complete typed payload or raise an ErrorEvent (no partial state).&#10;• Hand-offs are spans named exactly after the node ('extractor.run', 'retriever.run'); the eval rubric&#10;  asserts the recorded sequence matches the expected one for each fixture." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="880" width="1380" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
