        <mxCell id="ghaBand" value="GitHub Actions mirror — same harness on PR; PR check fails red" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e11d48;dashed=1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#9f1239;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gha" value=".github/workflows/agent-eval.yml&#xa;Triggers on pull_request. Pulls fixtures + baseline, runs the same rubric runner.&#xa;Posts a check (success/failure) to the PR. Branch protection requires this check to be green before merge.&#xa;Net effect: even pushes from a clone that skipped the local hook are still gated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="1360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="thresholds" value="Pass thresholds (per week-2-plan §4.11)&#10;schema_valid ≥ 0.95 · citation_present ≥ 0.98 · factually_consistent ≥ 0.85 · safe_refusal ≥ 0.90 · no_phi_in_logs = 1.00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="injectNote" value="Grading scenario&#10;The grader introduces a small regression (e.g., delete the bbox attachment in extractor.py). The harness's&#10;factually_consistent + citation_present rubrics drop, comparison vs. baseline returns &gt;5pp delta, push is blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
