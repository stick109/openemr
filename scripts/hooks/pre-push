#!/usr/bin/env bash
#
# OpenEMR Sidecar — pre-push eval gate.
#
# Runs the offline 50-case eval before allowing `git push` to complete. If
# the eval exits non-zero (a rubric regressed, a threshold breached, or the
# runner crashed) the push is aborted.
#
# This script is the source of truth — it is copied into `.git/hooks/pre-push`
# by `scripts/install-eval-hook.sh` (Unix) or `scripts/install-eval-hook.ps1`
# (Windows). The installer is responsible for backing up any existing hook
# before overwriting.
#
# Bypass (emergencies only)
# -------------------------
# To skip the eval for a single push — for example, when pushing a doc-only
# change while OpenAI is down or you need to land a hot-fix that touches
# something orthogonal to the agent — set:
#
#     SKIP_EVAL_HOOK=1 git push
#
# Use this sparingly. CI runs the same eval on every pull request and on
# pushes to master / codex/**, so a bypassed push will still be caught
# before merge.
#
# OPENAI_API_KEY handling
# -----------------------
# The hook unsets OPENAI_API_KEY in its own subshell before invoking the
# eval. The eval always uses FakeLLMClient, which deliberately refuses to
# construct while OPENAI_API_KEY is set (a safety guard against accidental
# real-API calls). The unset is scoped to this hook process only and does
# not affect the developer's outer shell.

set -euo pipefail

if [[ "${SKIP_EVAL_HOOK:-0}" == "1" ]]; then
    echo "[pre-push] SKIP_EVAL_HOOK=1 set -- skipping agent eval (emergency bypass)." >&2
    exit 0
fi

# FakeLLMClient guards against accidental real-API calls when OPENAI_API_KEY
# is set; the eval always uses fake clients, so unset within this hook
# process. This is scoped to the hook subshell only — the developer's outer
# shell is unaffected.
unset OPENAI_API_KEY

# Resolve repository root from the hook's location. `.git/hooks/pre-push` is
# two levels below the repo root, but the installer copies us there from
# `scripts/hooks/pre-push`, so we cannot rely on $0. Use git instead.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
    echo "[pre-push] error: not inside a git working tree." >&2
    exit 1
fi

agent_dir="${repo_root}/agent-service"
if [[ ! -d "${agent_dir}" ]]; then
    echo "[pre-push] error: agent-service directory not found at ${agent_dir}." >&2
    exit 1
fi

# Pick a Python launcher. The Windows `py` launcher is preferred when
# available (works under Git Bash); fall back to `python3` then `python`.
python_cmd=""
if command -v py >/dev/null 2>&1; then
    python_cmd="py"
elif command -v python3 >/dev/null 2>&1; then
    python_cmd="python3"
elif command -v python >/dev/null 2>&1; then
    python_cmd="python"
else
    echo "[pre-push] error: no Python interpreter found on PATH (looked for py, python3, python)." >&2
    echo "[pre-push] install Python 3.11+ or set SKIP_EVAL_HOOK=1 to bypass." >&2
    exit 1
fi

echo "[pre-push] Running agent eval with ${python_cmd} (set SKIP_EVAL_HOOK=1 to bypass in emergencies)." >&2

# Run from agent-service/ so the relative baseline path resolves the same way
# as in CI and the documented manual command.
cd "${agent_dir}"

if ! "${python_cmd}" -m agent_service.eval --baseline agent_service/eval/baseline.json; then
    echo "" >&2
    echo "[pre-push] agent eval failed -- push aborted." >&2
    echo "[pre-push] Re-run locally to debug:" >&2
    echo "[pre-push]     cd agent-service && ${python_cmd} -m agent_service.eval --baseline agent_service/eval/baseline.json" >&2
    echo "[pre-push] If this is an emergency, push with: SKIP_EVAL_HOOK=1 git push" >&2
    exit 1
fi

echo "[pre-push] agent eval passed -- proceeding with push." >&2
exit 0
