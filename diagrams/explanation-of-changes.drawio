        <mxCell id="layer4" value="Layer 4 — Security, Evidence &amp; PHI&#xa;&#xa;AgentAccessBroker, AgentAccessDecision, AgentAccessToken,&#xa;AgentCurrentPatientResolver, AgentPatientContext,&#xa;AgentPatientResolution,&#xa;Evidence/AgentEvidenceToolset, EvidenceCaps,&#xa;EvidencePacketNormalizer,&#xa;EvidenceRecordRepositoryInterface,&#xa;SqlEvidenceRecordRepository,&#xa;AgentEvidenceResponseBuilder, Anonymizer&#xa;&#xa;Patient binding, capped reads, PHI scrubbed in logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=12;spacing=10;align=left;" vertex="1" parent="1">
