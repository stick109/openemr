# Clinical Co-Pilot Sidecar Cutover Configuration (M20)
#
# This template documents the per-intent cutover from the legacy PHP
# Clinical Co-Pilot to the Python sidecar. Every intent starts in PHP
# mode (the safe default). Operators flip each intent to sidecar mode
# individually as parity is confirmed and a manual UI smoke test passes.
#
# The flags in this file are read by:
#   - src/Services/Agent/Sidecar/CopilotSidecarRouting.php (M19)
#   - tests/Tests/Isolated/Services/Agent/Sidecar/IntentCutoverPlanTest.php
#
# Copy the lines you want into your environment file (e.g.
# `docker/development-easy/.env`, kubernetes secrets, or shell exports)
# and uncomment them. Order is the documented M20 cutover order.

# -----------------------------------------------------------------------------
# Per-intent sidecar cutover (recommended order)
# -----------------------------------------------------------------------------
# Each flag accepts: php (default), shadow, or sidecar.
# Flip one at a time, run the parity tests + UI smoke test, then move on.

# Step 1: Basic patient data (snapshot, lowest blast radius).
# OPENEMR_COPILOT_INTENT_MODE_BASIC_PATIENT_DATA=sidecar

# Step 2: Current medications (high-traffic, structured data only).
# OPENEMR_COPILOT_INTENT_MODE_CURRENT_MEDICATIONS=sidecar

# Step 3: Allergies to confirm (similar surface to medications).
# OPENEMR_COPILOT_INTENT_MODE_ALLERGIES_TO_CONFIRM=sidecar

# Step 4: Recent events (mixes encounters, labs, vitals, procedures).
# OPENEMR_COPILOT_INTENT_MODE_RECENT_EVENTS=sidecar

# Step 5: Changed since last visit (multi-source diff).
# OPENEMR_COPILOT_INTENT_MODE_CHANGED_SINCE_LAST_VISIT=sidecar

# Step 6: Show source (drilldown; depends on the others having shipped).
# OPENEMR_COPILOT_INTENT_MODE_SHOW_SOURCE=sidecar

# -----------------------------------------------------------------------------
# Default mode (optional fallback for any intent without a per-intent flag)
# -----------------------------------------------------------------------------
# Recommended: leave unset until every per-intent flag above is set to
# sidecar, then flip the default to lock in the cutover. Setting this to
# sidecar prematurely will route any new intent through the sidecar
# before parity tests run.
#
# OPENEMR_COPILOT_DEFAULT_MODE=sidecar

# -----------------------------------------------------------------------------
# Emergency rollback
# -----------------------------------------------------------------------------
# Setting this to a truthy value (1, true, on, yes) forces ALL intents
# back to the PHP path regardless of every per-intent or default-mode
# flag above. Use this if a sidecar regression slips into production --
# it does not require touching per-intent settings, so the rollback is
# atomic.
#
# OPENEMR_COPILOT_EMERGENCY_DISABLE=1

# -----------------------------------------------------------------------------
# Legacy compatibility (kept for M17/M18 deployments)
# -----------------------------------------------------------------------------
# Older deployments use the boolean flags below. They still work, but
# the per-intent flags above take precedence and emergency disable
# overrides everything. Prefer the per-intent flags for new
# deployments.
#
# OPENEMR_COPILOT_SIDECAR_PROXY_ENABLED=1
# OPENEMR_COPILOT_SIDECAR_SHADOW_ENABLED=1
