# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=

# Clinical Co-Pilot LLM provider. Leave disabled unless a covered provider
# is configured server-side for PHI use.
OPENEMR_AGENT_LLM_PROVIDER=disabled
# Required kill switch. Set to true only after external model calls are approved.
OPENEMR_AGENT_LLM_EXTERNAL_CALLS_ENABLED=false
# Required when OPENEMR_AGENT_LLM_PROVIDER=openai.
OPENEMR_AGENT_LLM_MODEL=
# Server-side secret only. Do not expose this to browser code.
OPENAI_API_KEY=
# Alternative app-scoped key name accepted when OPENAI_API_KEY is not set.
OPENEMR_AGENT_LLM_API_KEY=
# Optional OpenAI-compatible base URI and timeout.
OPENEMR_AGENT_LLM_BASE_URI=https://api.openai.com/v1/
OPENEMR_AGENT_LLM_TIMEOUT_SECONDS=20
# Optional deployment-owned rates for observability cost counters.
OPENEMR_AGENT_LLM_INPUT_COST_PER_1M_TOKENS=0
OPENEMR_AGENT_LLM_OUTPUT_COST_PER_1M_TOKENS=0

# ── Agent Sidecar (Python) ──────────────────────────────────────────
# Base URL of the Python agent-service sidecar. In Docker Compose the
# container name resolves automatically; outside Docker use localhost.
OPENEMR_AGENT_SIDECAR_URL=http://agent-service:8010
# Shared secret sent in the X-Agent-Secret header to authenticate
# PHP→sidecar requests. Must match the value configured in the sidecar.
# Server-side secret only. Do not expose this to browser code.
OPENEMR_AGENT_SIDECAR_SECRET=
# HTTP timeout in seconds for sidecar requests (extraction + RAG can be
# slow; 60 s is the recommended minimum).
OPENEMR_AGENT_SIDECAR_TIMEOUT_SECONDS=60
# Cohere API key used by the sidecar for re-ranking retrieved evidence.
# Server-side secret only. Do not expose this to browser code.
COHERE_API_KEY=
# Honeycomb API key used by the sidecar for distributed tracing /
# observability. Server-side secret only. Do not expose this to browser code.
HONEYCOMB_API_KEY=
