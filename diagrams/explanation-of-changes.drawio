        <mxCell id="layer3" value="Layer 3 — Agent API &amp; Orchestration&#xa;&#xa;AgentIntentRestController, AgentIntentCatalog,&#xa;AgentLlmOrchestrator, AgentLlmConfig,&#xa;AgentLlmRequest / AgentLlmResponse,&#xa;AgentLlmProviderInterface, OpenAiResponsesAgentLlmProvider,&#xa;DisabledAgentLlmProvider, AgentAnswerSchema,&#xa;AgentAnswerVerifier, AgentVerificationResult,&#xa;ApiResponseLoggerListener&#xa;&#xa;POST /api/agent/intent → orchestrate → verify." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=12;spacing=10;align=left;" vertex="1" parent="1">
