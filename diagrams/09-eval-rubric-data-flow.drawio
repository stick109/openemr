<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Claude Code" version="26.0.0" type="device">
  <diagram id="w2-eval-rubric-data-flow" name="W2 Eval Rubric Data Flow">
    <mxGraphModel dx="1480" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Eval Rubric Data Flow — fixture → run → score → compare → exit code" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fixture" value="Fixture (one of 50)&#xa;{ id, doc_type, file_path,&#xa;  expected: { extracted, citations,&#xa;    rubrics: { schema_valid, citation_present,&#xa;      factually_consistent, safe_refusal,&#xa;      no_phi_in_logs } } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="mockOpenAI" value="Mock OpenAI client&#xa;Returns the recorded VLM output for this fixture&#xa;(deterministic — no live calls in CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="run" value="Run agent flow&#xa;Same supervisor → workers code path as runtime&#xa;Captures: extracted, citations, tool_sequence,&#xa;refusal_reason, log_buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="score" value="Score 5 boolean rubrics&#xa;schema_valid: Pydantic .model_validate() returns OK&#xa;citation_present: every persisted field has Citation != None&#xa;factually_consistent: extracted matches expected.extracted (deep eq)&#xa;safe_refusal: corrupt input → refusal_reason set, no DB writes&#xa;no_phi_in_logs: regex blocklist sweep over log_buffer returns []" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="aggregate" value="Aggregate over 50 fixtures&#xa;current[rubric] = passed / total&#xa;Records per-rubric pass-rate, per-rubric failures by id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="320" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="baseline" value="baseline.json&#xa;{ rubric: pass_rate } from last green commit&#xa;Refreshed only on intentional regression resets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1140" y="320" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="Compare current vs baseline&#xa;regressed = any( baseline[r] - current[r] &gt; 0.05 )&#xa;below_threshold = any( current[r] &lt; absolute_min[r] )&#xa;phi_violation = current.no_phi_in_logs &lt; 1.00&#xa;fail = regressed or below_threshold or phi_violation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="Exit code&#xa;0 → push proceeds, baseline auto-updates to current&#xa;1 → push blocked; report printed to stderr;&#xa;     PR check (GHA mirror) goes red" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="560" width="680" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="fixture" target="mockOpenAI">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="mockOpenAI" target="run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="ExtractionResult + log_buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="run" target="score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="rubric vector per fixture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="score" target="aggregate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="baseline" target="compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="current[rubric]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="aggregate" target="compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="bool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#7c3aed;fontSize=12;" edge="1" parent="1" source="compare" target="exit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Why boolean (not 1–10) rubrics&#10;The assignment is explicit: 'Use boolean rubrics so failures are actionable.' Numeric scoring tempts the&#10;judge model to round; boolean forces a yes/no. The grader's regression injection becomes a count, not&#10;an opinion — and the diff between current and baseline is a percentage of fixtures, not a vibes shift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1360" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
