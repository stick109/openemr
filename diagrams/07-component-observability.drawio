<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Claude Code" version="26.0.0" type="device">
  <diagram id="w2-component-observability" name="W2 Observability">
    <mxGraphModel dx="1480" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Observability — encounter event, PHI redactor, Honeycomb demo traces, OpenEMR DB records" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="event" value="EncounterEvent (per agent run)&#xa;trace_id · patient_id (HMAC) · doc_type&#xa;tool_sequence: list[str]&#xa;latency_ms_per_step: dict[str, int]&#xa;tokens_in / tokens_out: int&#xa;cost_usd: float (computed from model price table)&#xa;retrieval_hits: int&#xa;extraction_confidence: float&#xa;eval_outcome: dict[rubric, bool] | None&#xa;model: str · embedding_model: str&#xa;refusal_reason: str | None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="redactor" value="PHI redactor — runs BEFORE export&#xa;1. Pydantic 'Sanitized' view drops fields not on allowlist&#xa;2. Regex blocklist on free-text leaves: SSN, DOB, full names, MRN, phone, email, address&#xa;3. patient_id replaced with HMAC(patient_id, secret) so traces still cluster but the raw id never lands SaaS-side&#xa;4. If redaction fails (regex throws / view raises), event drops with redaction_status='failed' — never partial leaks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="otel" value="OpenTelemetry exporter&#xa;Spans:&#xa;  agent.run · supervisor.route · extractor.run&#xa;  retriever.run · supervisor.finalize · agent.refuse&#xa;Attributes (post-redaction):&#xa;  trace_id, model, doc_type_kind, latency_ms,&#xa;  tokens_in/out, cost_usd, retrieval_hits, eval_outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="honey" value="Honeycomb (free tier)&#xa;Sanitized demo traces/spans only&#xa;Dashboards from SAFE attributes&#xa;No raw PHI; no durable records&#xa;Per-trace inspector for hand-off review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1040" y="450" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="localStore" value="Existing OpenEMR MariaDB/MySQL&#xa;tables: token_log, cost_log, latency_log, eval_run, refusal_audit&#xa;Durable records for the cost-and-latency report (§4.17)&#xa;Lives in the Railway project; never copied to SaaS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="450" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="oemrAudit" value="OpenEMR audit log&#xa;trace_id mirrored into the existing audit table&#xa;Lets a clinician re-find a Honeycomb trace from inside the chart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="PHI rules (zero tolerance — rubric no_phi_in_logs = 1.00)&#10;• MUST NOT contain: raw PDF text, names, DOB, address, MRN, account number, SSN, phone, email, photos.&#10;• MAY contain: lab values + units, LOINC codes, abnormal flags, doc_type kind, model name, token counts, costs.&#10;• A pre-emit unit test injects a synthetic PHI string into every span attribute and asserts the redactor catches it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="1360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="raw event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="event" target="redactor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="redacted span" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="redactor" target="otel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="OTLP export" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#9f1239;fontSize=12;" edge="1" parent="1" source="otel" target="honey">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="durable metric rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0284c7;fontSize=12;" edge="1" parent="1" source="event" target="localStore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="trace_id only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0284c7;fontSize=12;" edge="1" parent="1" source="event" target="oemrAudit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="costNote" value="Cost computation&#10;cost_usd = sum_over_calls( tokens_in × prompt_rate[model] + tokens_out × completion_rate[model] ) + retrieval_hits × rerank_rate.&#10;Rates live in agent_service/cost_table.py and are versioned with the source. The Week 2 cost report aggregates&#10;OpenEMR DB observability records by day and by call site for the §4.17 deliverable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="1360" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
