# S-changes-tests.ps1 / M-changes-tests.ps1).
/M-changes-tests.*.log
/S-changes-tests.*.log

# generated synthetic lab PDFs (output of generate-lab-pdf.ps1)
/lab-reports/

# generated synthetic intake-form PDFs (output of generate-intake-form.ps1)
/intake-forms/

