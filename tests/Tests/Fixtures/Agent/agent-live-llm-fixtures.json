{
  "version": "agent-live-llm.v1",
  "comment": "Fixtures for live end-to-end LLM evals. Each case feeds the real provider through retrieval->prompt->LLM->verifier and asserts the answer passes verification. expected.contains_substring is checked case-insensitively against the rendered claim text.",
  "patient_id": 123,
  "cases": [
    {
      "id": "live_current_medications_with_records",
      "description": "Two active medications. The LLM should cite both and produce a verifiable answer.",
      "intent_id": "current_medications",
      "granted_data_classes": ["medications"],
      "granted_tools": ["current_medications", "show_source"],
      "packet": {
        "request_id": "live-eval-current-medications-with-records",
        "intent_id": "current_medications",
        "sources": [
          {
            "source_id": "medication:lists_medication:1101",
            "source_type": "medication",
            "data_class": "medications",
            "table": "lists_medication",
            "record_id": "1101",
            "patient_id": 123,
            "date": "2026-03-12",
            "status": "active",
            "display": "Metformin 500 mg twice daily",
            "excerpt": "Metformin 500 mg twice daily",
            "fields_used": ["title", "drug_dosage_instructions"],
            "reliability": "structured_active_record"
          },
          {
            "source_id": "medication:lists_medication:1102",
            "source_type": "medication",
            "data_class": "medications",
            "table": "lists_medication",
            "record_id": "1102",
            "patient_id": 123,
            "date": "2026-03-12",
            "status": "active",
            "display": "Lisinopril 10 mg once daily",
            "excerpt": "Lisinopril 10 mg once daily",
            "fields_used": ["title", "drug_dosage_instructions"],
            "reliability": "structured_active_record"
          }
        ],
        "checked_evidence": ["medications"],
        "tool_runs": [
          {
            "tool": "get_current_medications",
            "source_count": 2,
            "latency_ms": 1,
            "error_class": null
          }
        ]
      },
      "expected": {
        "contains_substring": ["Metformin", "Lisinopril"]
      }
    },
    {
      "id": "live_current_medications_empty",
      "description": "No medications were retrieved. The LLM must say 'not found in checked evidence' rather than implying the chart is empty.",
