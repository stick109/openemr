@page "{pid}"
@model OpenEmr.Dashboard.Pages.Patient.IndexModel
@{
    ViewData["Title"] = $"Patient {Model.Pid}";
}

@if (Model.FhirPatient is not null)
{
    <partial name="_PatientHeader" model="Model.FhirPatient" />
}

<div class="container-fluid py-3">
    <div class="row g-3">
        @* T11 swaps this placeholder for: <partial name="_AllergiesCard" model="Model.Allergies" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Allergies</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>

        @* T12 swaps this placeholder for: <partial name="_ProblemsCard" model="Model.Problems" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Problem List</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>

        @* T13 swaps this placeholder for: <partial name="_MedicationsCard" model="Model.Medications" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Medications (active)</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>

        @* T13 swaps this placeholder for: <partial name="_PrescriptionsCard" model="Model.Prescriptions" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Prescriptions (history)</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>

        @* T14 swaps this placeholder for: <partial name="_CareTeamCard" model="Model.CareTeam" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Care Team</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>

        @* T15 swaps this placeholder for: <partial name="_EncountersCard" model="Model.Encounters" /> *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">Encounters</div>
                <div class="card-body text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>
