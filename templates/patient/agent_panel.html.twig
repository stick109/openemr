<style>
    body.agent-loading-cursor,
    body.agent-loading-cursor *,
    .agent-panel.is-agent-loading,
    .agent-panel.is-agent-loading * {
        cursor: wait !important;
    }

    .agent-panel {
        max-width: 1180px;
    }

    .agent-panel__toolbar {
        gap: 0.5rem;
    }

    .agent-panel__intents {
        gap: 0.375rem;
    }

    .agent-panel__intents .btn {
        border-radius: 0.25rem;
    }

    .agent-panel__prompt {
        min-width: min(28rem, 100%);
        max-width: 40rem;
    }

    .agent-panel__status {
        min-height: 1.25rem;
    }

    .agent-panel__output[hidden] {
        display: none !important;
    }

    .agent-panel__output:not(:empty) {
        border-top: 1px solid #dee2e6;
        margin-top: 0.5rem;
        padding-top: 0.75rem;
    }

    .agent-panel__heading {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .agent-panel__claim-list {
        margin-bottom: 0.75rem;
        padding-left: 1.25rem;
    }

    .agent-panel__claim-list li + li {
        margin-top: 0.375rem;
    }

    .agent-panel__source-link {
        font-size: inherit;
        line-height: inherit;
        text-decoration: underline;
        vertical-align: baseline;
    }

    @media (max-width: 575.98px) {
        .agent-panel__prompt {
            flex-basis: 100%;
            max-width: none;
        }
    }
</style>

<div
    class="agent-panel mt-3"
    data-agent-panel="patient-chart"
    data-api-url="{{ apiUrl|attr }}"
    data-api-csrf-token="{{ apiCsrfToken|attr }}"
    data-loading-label="{{ "LOADING"|xla }}..."
    data-request-failed-label="{{ "Request failed."|xla }}"
    data-no-response-label="{{ "No agent response was returned."|xla }}"
    data-unavailable-label="{{ "Agent endpoint is unavailable."|xla }}"
    data-missing-label="{{ "Missing or uncertain"|xla }}"
    data-evidence-label="{{ "Checked evidence"|xla }}"
    data-none-label="{{ "None"|xla }}"
    data-source-label="{{ "source"|xla }}"
    data-source-aria-label="{{ "Show source"|xla }}"
    data-source-prompt-text="{{ sourceIntent.prompt_text|default('')|attr }}"
>
    <div class="agent-panel__toolbar d-flex flex-wrap align-items-start mb-2">
        <div class="agent-panel__intents d-flex flex-wrap mb-1">
            {% for intent in intents %}
                <button
                    type="button"
                    class="btn btn-sm btn-outline-primary js-agent-intent"
                    data-intent-id="{{ intent.intent_id|attr }}"
                    data-prompt-text="{{ intent.prompt_text|attr }}"
                >{{ intent.button_label|text }}</button>
            {% endfor %}
        </div>
        <div class="agent-panel__prompt input-group flex-grow-1 mb-1">
            <input
                type="text"
                class="form-control js-agent-prompt-preview"
                value=""
                readonly
                aria-readonly="true"
                aria-label="{{ "Prompt preview"|xla }}"
                tabindex="-1"
            />
            <div class="input-group-append">
                <button type="button" class="btn btn-secondary js-agent-send-preview" disabled>{{ "Send"|xlt }}</button>
            </div>
        </div>
    </div>
    <div class="agent-panel__status small text-muted mb-2 js-agent-status" aria-live="polite">{{ "Ready"|xlt }}</div>
    <div class="agent-panel__output js-agent-output"></div>
</div>

<script src="{{ webroot|attr }}/interface/patient_file/summary/agent_panel.js?v={{ agentPanelAssetVersion|default(assetVersion)|attr_url }}"></script>
