<mxfile host="app.diagrams.net" modified="2026-05-01T14:00:00.000Z" agent="Claude Code" version="26.0.0" type="device">
  <diagram id="agent-orchestration" name="Agent Orchestration">
    <mxGraphModel dx="1480" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Agent Orchestration — AgentLlmOrchestrator::buildVerifiedAnswer()" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Five layers — caller, provider gate, LLM round-trip, verify and fallback, anonymized logging." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="100" y="68" width="1280" height="32" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="1. Caller / Inputs&#xa;&#xa;AgentIntentRestController&#xa;→ buildVerifiedAnswer($intent, $accessToken, $packet, $deterministicAnswer)&#xa;&#xa;intent: AgentIntentCatalog entry (intent_id, button_label, prompt template, caps)&#xa;accessToken: AgentAccessBroker → AgentAccessToken (patient binding)&#xa;packet: AgentEvidenceResponseBuilder + AgentEvidenceToolset (sources, tool_runs)&#xa;deterministicAnswer: non-LLM fallback that the verifier must also approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=15;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="1360" height="170" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="2. Provider Gate&#xa;&#xa;AgentLlmProviderFactory::create()&#xa;  → OpenAiResponsesAgentLlmProvider | DisabledAgentLlmProvider&#xa;AgentLlmConfig::fromEnvironment()&#xa;  — strips UTF-8 BOM, validates API key &amp; model&#xa;AgentLlmProviderInterface::isConfigured() — the gate&#xa;AgentLlmProviderInterface::getConfigurationIssue()&#xa;  → 'missing_api_key' | 'missing_model' | 'provider_disabled'&#xa;baseLlmMetadata() seeds llm metadata&#xa;  (provider, model, fallback_reason, usage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="660" height="240" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="3. LLM Round-Trip&#xa;&#xa;new AgentLlmRequest(intent, evidencePacket,&#xa;  AgentAnswerSchema::jsonSchema())&#xa;logLlmRequest() — anonymized 'agent.llm.started'&#xa;  + readable request block&#xa;provider->complete($request) → AgentLlmResponse&#xa;  (answer + usage metadata)&#xa;AgentAnswerSchema::normalize($answer) →&#xa;  answer_blocks[].claims[] + missing_or_uncertain[]&#xa;catch (Throwable) → 'agent.llm.failed' (error_class),&#xa;  fallback_reason='provider_error'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=15;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="310" width="660" height="240" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="4. Verify &amp; Fallback&#xa;&#xa;AgentAnswerVerifier::verify($answer, $accessToken, $packet)&#xa;  passed → verifiedResponse('llm_structured_verified', …)&#xa;  failed → logVerificationFailure() + retry verifier on $deterministicAnswer&#xa;     passed → 'deterministic_verified_fallback' (or 'deterministic_verified' when provider unconfigured)&#xa;     failed → systemRefusal() → 'verified_refusal' (system_refusal warning)&#xa;Always exits via verifiedResponse(): { status, response_generation, answer, verification, llm }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=15;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="1360" height="220" as="geometry" />
        </mxCell>

        <mxCell id="L5" value="5. Anonymized Logging&#xa;&#xa;Anonymizer::anonymizePayload($accessToken, $payload) wraps every log emission&#xa;anonymizedLlmRequest() — splits instructions, decodes JSON input, scrubs identifiers&#xa;anonymizedLlmResponse() — scrubs structured answer before it lands in 'agent.llm.finished'&#xa;Failure mode: 'redaction_status: failed' + redaction_error_class — raw text never leaks&#xa;Events: agent.llm.started · agent.llm.finished · agent.llm.failed&#xa;       · agent.verification.failed · agent.verification.deterministic_fallback_failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=15;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="1360" height="220" as="geometry" />
        </mxCell>

        <mxCell id="edge-l1-l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#475569;endArrow=block;endFill=1;" edge="1" parent="1" source="L1" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-l2-l3" value="isConfigured = true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#16a34a;endArrow=block;endFill=1;fontSize=14;fontColor=#0f172a;" edge="1" parent="1" source="L2" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-l2-l4" value="isConfigured = false → deterministic path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#7c3aed;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#0f172a;" edge="1" parent="1" source="L2" target="L4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-l3-l4" value="normalized answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#475569;endArrow=block;endFill=1;fontSize=14;fontColor=#0f172a;" edge="1" parent="1" source="L3" target="L4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-l3-l5" value="agent.llm.* events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#e11d48;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#0f172a;" edge="1" parent="1" source="L3" target="L5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-l4-l5" value="agent.verification.* events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#e11d48;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#0f172a;" edge="1" parent="1" source="L4" target="L5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
