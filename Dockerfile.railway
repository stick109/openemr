FROM openemr/openemr:latest@sha256:1d8073d3acfc15b53e771f264b84c0be41a0f0c998f413af39811e1c2e5d8061

WORKDIR /var/www/localhost/htdocs/openemr

# Overlay this checkout's application source onto the pinned production image.
# Runtime secrets come from Railway variables, not from files copied into the image.
COPY --chown=apache:apache . /var/www/localhost/htdocs/openemr/

# Align the base image's vendor/ tree with this checkout's composer.lock after
# overlaying source. Otherwise production can run current app code against
# stale dependency versions and stale Composer classmaps from the pinned image.
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader \
    && chown -R apache:apache /var/www/localhost/htdocs/openemr/vendor
