@page "{pid}"
@model OpenEmr.Dashboard.Pages.Patient.IndexModel
@{
    ViewData["Title"] = $"Patient {Model.Pid}";
}

@if (Model.FhirPatient is not null)
{
    <partial name="_PatientHeader" model="Model.FhirPatient" />
}

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <partial name="_AllergiesCard" model="Model.Allergies" />
        </div>

        <div class="col-12 col-lg-4">
            <partial name="_ProblemsCard" model="Model.Problems" />
        </div>

        <div class="col-12 col-lg-4">
            <partial name="_MedicationsCard" model="Model.Medications" />
        </div>

        <div class="col-12 col-lg-4">
            <partial name="_PrescriptionsCard" model="Model.Prescriptions" />
        </div>

        <div class="col-12 col-lg-4">
            <partial name="_CareTeamCard" model="Model.CareTeam" />
        </div>

        <div class="col-12 col-lg-4">
            <partial name="_EncountersCard" model="Model.Encounters" />
        </div>

        <div class="col-12">
            <partial name="_CopilotCard" model="Model" />
        </div>
    </div>
</div>
