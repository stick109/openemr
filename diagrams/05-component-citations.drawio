<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Claude Code" version="26.0.0" type="device">
  <diagram id="w2-component-citations" name="W2 Citation Flow">
    <mxGraphModel dx="1480" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Citation Flow — extraction → DB → click-to-source UI overlay" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="model" value="Citation (Pydantic v2)&#xa;source_type: Literal['lab_pdf','intake_form','guideline','openemr_record']&#xa;source_id: str   # OpenAI file_id, guideline chunk_id, or DB row id&#xa;page_or_section: str   # 'page 2', '§4.1'&#xa;field_or_chunk_id: str   # 'results[0].value' or 'chunk_42'&#xa;quote_or_value: str&#xa;bbox: tuple[x, y, w, h] | None   # PDF only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="Contract&#10;• Every persisted clinical fact must have a non-null Citation.&#10;• rubric: citation_present asserts this on every fixture.&#10;• PDF-derived citations carry a bbox so the UI can draw an overlay.&#10;• Guideline citations omit bbox; the UI links source_url instead." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="src1" value="Extractor (Python)&#xa;OpenAI Structured Outputs&#xa;LabResult.source_citation: Citation&#xa;Demographics.dob.source_citation: Citation&#xa;Bbox returned by VLM, validated &gt;0 area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src2" value="Retriever (Python)&#xa;Cohere top-5 chunks&#xa;Citation.source_type='guideline'&#xa;page_or_section = chunk metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api" value="ExtractionResult (HTTP response)&#xa;{ extracted, evidence, citations, ... }&#xa;Returned to PHP save.php" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phpDb" value="PHP dispatcher writes:&#xa;1. patient_data / procedure_result / questionnaire_response (the fact)&#xa;2. form_upload_intake_form_citation (the citation row pointing back)&#xa;Both rows share a form_id so they can be joined in view.php" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="view.php click-to-source UI&#xa;• pdf.js renders the original document&#xa;• fetch /modules/upload-intake-form/citations?form_id=X → JSON of citations&#xa;• On hover/focus on an extracted field, draw a translucent box at (bbox)&#xa;• On click, scroll PDF to (page) and flash overlay&#xa;• Guideline citations open a side panel with the snippet + source_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="470" width="600" height="200" as="geometry" />
        </mxCell>
        <mxCell id="table" value="Schema — form_upload_intake_form_citation&#xa;id INT PK · form_id FK · field_path VARCHAR(255)&#xa;source_type ENUM · source_id VARCHAR(255)&#xa;page_or_section VARCHAR(64) · field_or_chunk_id VARCHAR(255)&#xa;quote_or_value TEXT&#xa;bbox_x FLOAT · bbox_y FLOAT · bbox_w FLOAT · bbox_h FLOAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="510" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;" edge="1" parent="1" source="src1" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#16a34a;" edge="1" parent="1" source="src2" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="dispatch + persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0f766e;fontSize=12;" edge="1" parent="1" source="api" target="phpDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="INSERT citation rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#c2410c;fontSize=12;" edge="1" parent="1" source="phpDb" target="table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="JOIN field → citation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#0284c7;fontSize=12;" edge="1" parent="1" source="table" target="ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#475569;" edge="1" parent="1" source="model" target="src1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=open;dashed=1;strokeColor=#475569;" edge="1" parent="1" source="model" target="src2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="trustNote" value="Trust boundary&#10;The bbox originates with the VLM. We validate (a) it lies inside the page, (b) area &gt; 0, and (c) cropping the&#10;page at bbox yields text whose normalized form contains quote_or_value. If any check fails, the field is&#10;rejected and the row is not persisted — the rubric factually_consistent then surfaces the regression." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1360" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
