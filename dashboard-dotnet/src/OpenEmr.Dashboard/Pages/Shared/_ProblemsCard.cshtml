@using OpenEmr.Dashboard.Fhir.Records
@inject IConfiguration Cfg
@model OpenEmr.Dashboard.Fhir.Records.CardResult<FhirCondition>
@{
    var oeUrl = (Cfg["OPENEMR_PUBLIC_URL"] ?? string.Empty).TrimEnd('/');
    var pidValue = ViewContext.RouteData.Values["pid"]?.ToString() ?? string.Empty;
    var hasOe = !string.IsNullOrWhiteSpace(oeUrl) && !string.IsNullOrWhiteSpace(pidValue);

    // The FHIR Condition id is a UUID; add_edit_issue.php's `issue` parameter
    // is the legacy numeric lists.id. open_problem_by_uuid.php resolves the
    // UUID server-side and 302s to the editor with the numeric id, mirroring
    // the encounter/medication shims under interface/patient_file/.
    string? IssueLink(string? conditionUuid)
    {
        if (!hasOe || string.IsNullOrWhiteSpace(conditionUuid))
        {
            return null;
        }
        return $"{oeUrl}/interface/patient_file/summary/open_problem_by_uuid.php"
            + $"?uuid={Uri.EscapeDataString(conditionUuid)}"
            + $"&pid={Uri.EscapeDataString(pidValue)}";
    }
}
<div class="card h-100">
    <div class="card-header"><h2 class="h6 mb-0">Problem List</h2></div>
    @if (Model.HasError)
    {
        <div class="card-body">
            <div class="alert alert-danger mb-0" role="alert">@Model.Error</div>
        </div>
    }
    else if (Model.Data.Count == 0)
    {
        <div class="card-body text-muted" role="status">No problems recorded.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Problem</th>
                        <th scope="col">Code</th>
                        <th scope="col">Onset</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Data)
                {
                    var coding = c.FirstCoding();
                    var display = coding?.Display ?? c.Code?.Text ?? "(unspecified)";
                    var code = coding?.Code ?? string.Empty;
                    var onset = c.OnsetDateTime ?? c.RecordedDate ?? string.Empty;
                    var clinical = c.ClinicalStatusCode();
                    var verified = c.VerificationStatusCode();
                    var link = IssueLink(c.Id);
                    <tr>
                        <th scope="row" class="fw-normal">@display</th>
                        <td class="font-monospace small">@code</td>
                        <td class="small">@onset</td>
                        <td class="small">
                            @if (!string.IsNullOrWhiteSpace(clinical))
                            {
                                <span class="badge bg-light text-dark border me-1">@clinical</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(verified))
                            {
                                <span class="badge bg-light text-dark border">@verified</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (link is not null)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@link"
                                   aria-label="Open problem in OpenEMR">Open</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
