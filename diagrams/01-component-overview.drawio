          <mxGeometry x="60" y="120" width="640" height="380" as="geometry" />
        </mxCell>
        <mxCell id="phUi" value="interface/forms/upload_intake_form/&#xa;new.php · save.php · view.php · report.php&#xa;CSRF + ACL + 10MB PDF cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="280" height="80" as="geometry" />
        </mxCell>
