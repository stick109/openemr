FROM openemr/openemr:latest@sha256:1d8073d3acfc15b53e771f264b84c0be41a0f0c998f413af39811e1c2e5d8061

WORKDIR /var/www/localhost/htdocs/openemr

# Overlay this checkout's application source onto the pinned production image.
# Runtime secrets come from Railway variables, not from files copied into the image.
COPY --chown=apache:apache . /var/www/localhost/htdocs/openemr/

# Align the base image's vendor/ tree with this checkout's composer.lock after
# overlaying source. Otherwise production can run current app code against
# stale dependency versions and stale Composer classmaps from the pinned image.
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader \
    && chown -R apache:apache /var/www/localhost/htdocs/openemr/vendor

# SharedUploadManager writes incoming uploads to /var/uploads/agent for later
# retrieval by the embedded PDF viewer (interface/forms/upload_intake_form/pdf.php).
# Locally the docker-compose entrypoint shim creates this directory with sticky
# 1777 perms, but that shim does NOT run on Railway — the base image's own
# entrypoint takes over. Bake the directory into the image with apache
# ownership so PHP (uid 100) can write to it.
#
# In production we override the path via OPENEMR_AGENT_SHARED_DIR to point
# inside the persistent sites/ Railway volume, so files survive container
# restarts. The /var/uploads/agent fallback is kept only for local dev where
# a named docker volume is mounted there.
RUN mkdir -p /var/uploads/agent \
    && chown apache:apache /var/uploads/agent \
    && chmod 0755 /var/uploads/agent

# Patch the upstream openemr.sh entrypoint so the dashboard OAuth-client
# ensure script runs after auto_setup (with the persistent sites/ volume
# mounted) and before Apache starts. Done at build time as a one-shot sed
# instead of replacing ENTRYPOINT, to keep the rest of openemr.sh's
# bootstrap (mysql wait, install, key initialization, etc.) intact.
# The ensure script is invoked via `php` directly rather than a wrapper
# .sh file, because openemr.sh's auto_setup runs `find . -not -perm 600
# -exec chmod 600 {}` which would strip the executable bit from any
# wrapper script. `php` is always executable; the ensure .php file just
# needs to be readable. Idempotent: skipped if the marker is present.
RUN if ! grep -q 'ensure_dashboard_oauth_client' /var/www/localhost/htdocs/openemr/openemr.sh; then \
        sed -i 's|exec /usr/sbin/httpd -D FOREGROUND|php /var/www/localhost/htdocs/openemr/bin/ensure_dashboard_oauth_client.php \|\| true ; exec /usr/sbin/httpd -D FOREGROUND|' \
            /var/www/localhost/htdocs/openemr/openemr.sh ; \
    fi

# Ensure the agent-uploads directory inside the persistent sites/ Railway
# volume exists and is writable by apache before httpd starts. The volume
# is only mounted at runtime, so this must run from openemr.sh (root
# context) — we cannot bake it into the image. Idempotent mkdir + chown
# guarantees correct ownership even if the volume was created with another
# uid (e.g. root from a prior container) and survives across redeploys.
RUN if ! grep -q 'agent-uploads-init' /var/www/localhost/htdocs/openemr/openemr.sh; then \
        sed -i 's|exec /usr/sbin/httpd -D FOREGROUND|# agent-uploads-init: ensure SharedUploadManager target dir exists with apache ownership\n  mkdir -p /var/www/localhost/htdocs/openemr/sites/default/agent-uploads \&\& chown apache:apache /var/www/localhost/htdocs/openemr/sites/default/agent-uploads \&\& chmod 0755 /var/www/localhost/htdocs/openemr/sites/default/agent-uploads || true\n  exec /usr/sbin/httpd -D FOREGROUND|' \
            /var/www/localhost/htdocs/openemr/openemr.sh ; \
    fi
